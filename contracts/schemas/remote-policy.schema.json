{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blacktemple-kn.local/schemas/remote-policy.schema.json",
  "title": "RemotePolicyAllowlist",
  "description": "Only these keys may be applied from remote policy. Values are typed; no shell.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "x-apple-direct": { "type": "boolean" },
    "x-auto-switch": { "type": "boolean" },
    "x-black-key-protocol": { "type": "string" },
    "x-block-quic": { "type": "boolean" },
    "x-burst-block-sec": { "type": "integer", "minimum": 0 },
    "x-burst-max-concurrent": { "type": "integer", "minimum": 0 },
    "x-burst-subnet-limit": { "type": "integer", "minimum": 0 },
    "x-custom-route-action": { "type": "string", "enum": ["direct", "proxy", "block"] },
    "x-custom-route-domains": { "type": "array", "items": { "type": "string" } },
    "x-dns-direct": { "type": "string" },
    "x-domain-strategy": { "type": "string" },
    "x-fake-dns": { "type": "boolean" },
    "x-fragment-enabled": { "type": "boolean" },
    "x-fragment-interval": { "type": "string" },
    "x-fragment-length": { "type": "string" },
    "x-fragment-packets": { "type": "string" },
    "x-memory-saver": { "type": "boolean" },
    "x-mtu": { "type": "integer" },
    "x-mux-concurrency": { "type": "integer" },
    "x-mux-enabled": { "type": "boolean" },
    "x-mux-xudp-concurrency": { "type": "integer" },
    "x-mux-xudp-quic": { "type": "string" },
    "x-policy-buffer-size": { "type": "integer" },
    "x-policy-conn-idle": { "type": "integer" },
    "x-policy-downlink-only": { "type": "integer" },
    "x-policy-handshake": { "type": "integer" },
    "x-policy-uplink-only": { "type": "integer" },
    "x-sniffing": { "type": "boolean" },
    "x-tcp-fast-open": { "type": "boolean" },
    "x-tcp-no-delay": { "type": "boolean" },
    "x-telegram-ips": { "type": "string", "format": "uri" },
    "x-whatsapp-ips": { "type": "string", "format": "uri" }
  }
}
