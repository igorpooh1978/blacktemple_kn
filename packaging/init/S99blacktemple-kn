#!/bin/sh
# Entware init for blacktempled. Not systemd.
# If /opt/etc/init.d/rc.func exists it handles start/stop/restart.
# Fallback implements start/stop/restart/status/reload without it.

ENABLED=yes
PROCS=blacktempled
# FAIL CLOSED: loopback only. LAN bind is a later daemon flag, not all-interfaces.
ARGS="-listen 127.0.0.1:7480"
PREARGS=""
DESC="blacktemple-kn"
PREFIX=/opt/blacktemple-kn
BIN=$PREFIX/bin/blacktempled
PIDFILE=$PREFIX/run/blacktempled.pid
LOGFILE=$PREFIX/logs/blacktempled.log
PATH=$PREFIX/bin:/opt/sbin:/opt/bin:/opt/usr/bin:/usr/sbin:/usr/bin:/sbin:/bin

mkdir -p "$PREFIX/run" "$PREFIX/logs" 2>/dev/null || true

# Network-ready wait (condition loop with backoff, not a single delay).
# Capture is not applied here: NDM hook + blacktempled netfilter-reconcile.
# Timeout still starts the manager; missing Xray/route/LAN means fail-open.
has_default_route() {
	[ -r /proc/net/route ] || return 1
	while read _iface dest _rest; do
		if [ "$dest" = "00000000" ]; then
			return 0
		fi
	done < /proc/net/route
	return 1
}

network_ready() {
	opt_ok=0
	route_ok=0
	lan_ok=0
	xray_ok=0
	if [ -d /opt/etc ] && [ -d "$PREFIX" ]; then
		opt_ok=1
	fi
	if has_default_route; then
		route_ok=1
	fi
	if [ -d /sys/class/net/br0 ] || [ -d /sys/class/net/br1 ]; then
		lan_ok=1
	fi
	if [ -x "$PREFIX/bin/xray" ]; then
		xray_ok=1
	fi
	[ "$opt_ok" -eq 1 ] && [ "$route_ok" -eq 1 ] && [ "$lan_ok" -eq 1 ] && [ "$xray_ok" -eq 1 ]
}

wait_network_ready() {
	n=0
	delay=1
	while [ "$n" -lt 12 ]; do
		if network_ready; then
			return 0
		fi
		sleep "$delay"
		n=$((n + 1))
		delay=$((delay * 2))
		if [ "$delay" -gt 5 ]; then
			delay=5
		fi
	done
	return 1
}

cmd=$1

case "$cmd" in
	start|restart)
		wait_network_ready || true
		;;
esac

case "$cmd" in
	start|stop|restart)
		if [ -r /opt/etc/init.d/rc.func ]; then
			. /opt/etc/init.d/rc.func
			exit $?
		fi
		;;
esac

is_running() {
	if [ ! -f "$PIDFILE" ]; then
		return 1
	fi
	pid=$(cat "$PIDFILE" 2>/dev/null) || return 1
	if [ -z "$pid" ]; then
		return 1
	fi
	kill -0 "$pid" 2>/dev/null
}

do_start() {
	if [ ! -x "$BIN" ]; then
		echo "missing $BIN"
		return 1
	fi
	if is_running; then
		echo "already running"
		return 0
	fi
	rm -f "$PIDFILE"
	"$BIN" $ARGS >>"$LOGFILE" 2>&1 &
	echo $! >"$PIDFILE"
}

do_stop() {
	if [ ! -f "$PIDFILE" ]; then
		return 0
	fi
	pid=$(cat "$PIDFILE" 2>/dev/null) || true
	rm -f "$PIDFILE"
	if [ -z "$pid" ]; then
		return 0
	fi
	if ! kill -0 "$pid" 2>/dev/null; then
		return 0
	fi
	kill "$pid" 2>/dev/null || true
	n=0
	while [ "$n" -lt 8 ] && kill -0 "$pid" 2>/dev/null; do
		sleep 1
		n=$((n + 1))
	done
	if kill -0 "$pid" 2>/dev/null; then
		kill -9 "$pid" 2>/dev/null || true
	fi
}

do_status() {
	if is_running; then
		echo "running"
		return 0
	fi
	echo "stopped"
	return 1
}

do_restart() {
	do_stop
	do_start
}

case "$cmd" in
	start)
		do_start
		;;
	stop)
		do_stop
		;;
	restart)
		do_restart
		;;
	reload)
		do_restart
		;;
	status)
		do_status
		;;
	*)
		echo "Usage: $0 {start|stop|restart|reload|status}"
		exit 1
		;;
esac
